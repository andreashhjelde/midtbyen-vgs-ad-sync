# Eksempel på miljøvariabler for AD-sync.
# Kopier denne filen til ad-sync.env og fyll inn reelle verdier.
# ad-sync.env skal ikke legges i Git siden den inneholder passord.

LDAP_SERVER=dc01.midtbyen.local
BASE_DN=dc=midtbyen,dc=local

LDAP_BIND_USER=svc_linux_sync@midtbyen.local
LDAP_BIND_PASSWORD=CHANGE_ME

AD_USER_BASE_DN=OU=Brukere,DC=midtbyen,DC=local
AD_GROUP_BASE_DN=OU=Grupper,DC=midtbyen,DC=local

GROUP_PREFIX=linux-
